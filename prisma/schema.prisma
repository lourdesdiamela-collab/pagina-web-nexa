// Esquema de base de datos — NEXA
//
// PROVIDER: sqlite. Es lo que realmente hay hoy y lo que funciona sin
// configurar nada: la base es un archivo local (prisma/dev.db) y DATABASE_URL
// arranca con "file:".
//
// Corregido (septiembre 2026): el schema declaraba `postgresql`, pero todas
// las migraciones de prisma/migrations están escritas en SQL de SQLite y
// DATABASE_URL apuntaba a un archivo. Esa combinación no arranca: Prisma
// rechaza una URL "file:" cuando el provider es postgres. Ahora los tres
// coinciden en SQLite.
//
// SI ALGÚN DÍA SE PASA A POSTGRES (Vercel Postgres / Neon), hay que hacer tres
// cosas juntas, no una sola:
//   1) cambiar `provider` acá a "postgresql"
//   2) cambiar el provider en prisma/migrations/migration_lock.toml
//   3) regenerar el historial de migraciones (el SQL de SQLite no corre en
//      Postgres: DATETIME no existe, va TIMESTAMP(3))
//
// Nota: los campos de "enum" se modelan como String (no `enum` de Prisma) a
// propósito, para que el mismo schema funcione igual en SQLite (que no
// soporta enums nativos) y en Postgres sin tener que reescribirlo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders  Order[]
  reviews Review[]
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  fullLabel String
  color     String  @default("#835CE6")
  sortOrder Int     @default(0)

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String
  price       Int
  level       String   @default("Todos los niveles")
  pages       Int      @default(20)
  readTime    String   @default("30 min")
  includes    String   @default("[]") // JSON.stringify(string[])
  featured    Boolean  @default(false)
  bestSeller  Boolean  @default(false)
  isNew       Boolean  @default(false)
  onSale      Boolean  @default(false)
  fileUrl     String? // ruta/URL del PDF real. null = "próximamente" (aún no subido por admin)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reviews    Review[]
  orderItems OrderItem[]

  @@index([categoryId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  name      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([productId])
}

model Order {
  id             String   @id @default(cuid())
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  originalTotal  Int
  total          Int
  savings        Int      @default(0)
  couponCode     String?
  mpPreferenceId String?
  mpPaymentId    String?
  payerEmail     String?

  // Aceptación de los Términos y Condiciones en el checkout.
  // Se guarda para poder demostrar, ante un reclamo, quién aceptó qué y cuándo.
  // El "quién" es el userId del pedido (más el email, que queda en User).
  termsAcceptedAt DateTime? // fecha y hora exactas de la aceptación
  termsAcceptedIp String? //   IP desde la que se aceptó
  termsVersion    String? //   versión del texto de T&C vigente al aceptar

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id       String @id @default(cuid())
  title    String // snapshot del título al momento de la compra
  price    Int // precio regular unitario al momento de la compra
  qty      Int    @default(1)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String    @default("PERCENT") // PERCENT | FIXED
  value      Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

/*
 * Leads que entran por el sitio: formulario de contacto y checkout de
 * servicios.
 *
 * Antes lib/crm.js era un stub que recibía el lead y NO lo guardaba en ningún
 * lado: devolvía el objeto y listo. Los únicos registros eran los emails que le
 * llegaban a Lu, así que un mail perdido o en spam era un lead perdido, sin
 * rastro. Ahora cada lead queda acá.
 *
 * Esta es la base del SITIO. El CRM (repo Nexa-CRM) es otro sistema con su
 * propia base: el envío al CRM se sigue intentando desde /api/contact, y el
 * campo `syncedToCrm` deja registrado si esa sincronización salió bien. Los
 * que queden en false hay que pasarlos al CRM cuando la integración exista.
 */
model Lead {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  company String?

  service String? // línea de servicio consultada o contratada
  message String? // el "challenge" del formulario, o el detalle del pedido

  // De dónde vino: formulario_contacto | checkout_servicio_transferencia |
  // checkout_servicio_mercadopago
  source String @default("formulario_contacto")

  // Solo para leads que vienen del checkout de servicios
  reference String? // referencia del pedido (SRV-...)
  planId    String? // identificador del plan (ver lib/servicePlans.mjs)
  amount    Int? // monto en pesos resuelto por el servidor

  // Aceptación de Términos y Condiciones (ver lib/terms.js)
  termsAcceptedAt DateTime?
  termsAcceptedIp String?
  termsVersion    String?

  // Sincronización con el CRM central
  syncedToCrm Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}
