# Copiar a .env.local (y/o .env para Prisma) y completar.

# --- Base de datos ---
# Dev local: SQLite, no requiere configuración (ya viene lista en .env).
# Producción: Postgres administrado (Vercel Postgres / Neon). Ejemplo:
# DATABASE_URL="postgresql://usuario:password@host:5432/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- NextAuth (cuentas de usuario) ---
NEXTAUTH_URL=http://localhost:3000
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Usuario admin sembrado por prisma/seed.mjs ---
ADMIN_EMAIL=lu@nexaarg.com
ADMIN_PASSWORD=

# --- Mercado Pago (Checkout Pro) ---
# Obtener en https://www.mercadopago.com.ar/developers/panel/app -> tu aplicación
# -> Credenciales de producción, con la cuenta de vendedor real de NEXA.
#
# SIN ESTAS VARIABLES EL CHECKOUT NO OFRECE PAGO CON TARJETA: muestra un aviso
# de que el pago online no está disponible y deriva a transferencia bancaria.
#
# MP_ACCESS_TOKEN  -> "Access Token" de producción (empieza con APP_USR-).
#                     Es SECRETO: va solo en variables de entorno del servidor,
#                     nunca en el código ni en el repo.
# MP_PUBLIC_KEY    -> "Public Key" de producción (empieza con APP_USR-).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Clave secreta del webhook de Mercado Pago, para validar la firma de las
# notificaciones (header x-signature). Se genera en el mismo panel:
# tu aplicación -> Webhooks -> Configurar notificaciones -> "Clave secreta".
# Si queda vacía, el webhook igual funciona (verifica cada pago contra la API
# de MP antes de aprobar nada) pero no valida la firma. Recomendado cargarla.
MP_WEBHOOK_SECRET=

# --- Simulador de pago — SOLO DESARROLLO LOCAL ---
# Habilita /api/checkout/simulate y el botón "Simular pago aprobado", que
# aprueba un pedido SIN PAGO REAL. Sirve para probar el flujo completo sin
# credenciales de Mercado Pago.
#
# ¡NUNCA cargar esta variable en producción ni en Vercel! Aun así, el código
# exige además NODE_ENV=development y VERCEL_ENV != production/preview, así que
# un deploy no puede habilitarlo por accidente (ver lib/mercadopago.js).
# Dejar vacío o sin definir en cualquier entorno que no sea tu máquina.
ALLOW_PAYMENT_SIMULATION=

# --- Email (reutiliza el mismo transporter que /api/contact) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=hola@nexaarg.com

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- CRM central (Nexa-CRM) ---
# A dónde le pega el sitio para el formulario de contacto y la alta
# automática por pago. Si queda vacía, usa https://crm.nexagrowth.com.ar.
NEXT_PUBLIC_CRM_URL=https://crm.nexagrowth.com.ar

# Secreto compartido con el CRM: autentica las llamadas del sitio a
# /api/leads y /api/integrations/pago-servicio (alta automática por pago).
# Mismo valor EXACTO que SITE_TO_CRM_SECRET en el proyecto de Vercel del
# CRM (Nexa-CRM). Sin esta variable, la alta automática no funciona: el
# pago queda registrado en el Lead como "sin sincronizar" (ver
# /aprende/admin/leads) para reintentar cuando la variable esté cargada.
# Generá un valor con: openssl rand -hex 32
SITE_TO_CRM_SECRET=
