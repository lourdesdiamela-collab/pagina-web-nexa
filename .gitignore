# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example nunca tiene secretos reales, solo placeholders -- tiene que
# quedar versionado para que la lista de variables no se pierda. Se
# descubrió corriendo `git ls-files` que este archivo nunca había estado
# en el repo pese a documentarse en varias sesiones: el patrón de arriba lo
# tapaba.
!.env.example

# clave de sesión generada automáticamente si no hay NEXTAUTH_SECRET
# (ver lib/auth.js). NUNCA subir esto: permite falsificar sesiones.
/.nexa/

# vercel
.vercel

# base de datos local (dev) y archivos subidos por el admin
/prisma/dev.db
/prisma/dev.db-journal
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/**/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

/lib/generated/prisma
